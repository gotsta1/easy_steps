[Unit]
Description=EasySteps host disk alerts to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/easysteps-monitor.env
ExecStart=/usr/bin/python3 /opt/easy_steps/ops/disk_monitor.py
StateDirectory=easysteps-monitor
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=45
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
